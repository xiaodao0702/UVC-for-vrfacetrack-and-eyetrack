<?xml version="1.0" encoding="utf-8"?>
<com.omoai.simpleuvcstreamer.ui.SteadyNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/brand_title"
            android:textAppearance="@style/Text.Uvc.Brand" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/brand_subtitle"
            android:textAppearance="@style/Text.Uvc.Label" />

        <!-- Camera 1 -->
        <include
            android:id="@+id/cardCamera1"
            layout="@layout/card_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <!-- Camera 2 -->
        <include
            android:id="@+id/cardCamera2"
            layout="@layout/card_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- Cymple 直连（DIY 眼追/面捕摄像头协议） -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Uvc.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cymple_section"
                    android:textAppearance="@style/Text.Uvc.Section" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchCymple"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="false"
                    android:text="@string/cymple_switch"
                    android:textAppearance="@style/Text.Uvc.Body" />

                <TextView
                    android:id="@+id/tvCympleStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/cymple_status_off"
                    android:textAppearance="@style/Text.Uvc.Label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCympleFlag1"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/cymple_position_hint_1">

                    <AutoCompleteTextView
                        android:id="@+id/dropdownCympleFlag1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCympleFlag2"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/cymple_position_hint_2">

                    <AutoCompleteTextView
                        android:id="@+id/dropdownCympleFlag2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/cymple_hint"
                    android:textAppearance="@style/Text.Uvc.Label" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Global settings -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Uvc.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_general"
                    android:textAppearance="@style/Text.Uvc.Section" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="false"
                    android:text="@string/switch_auto_start"
                    android:textAppearance="@style/Text.Uvc.Body" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoLaunch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="@string/switch_auto_launch"
                    android:textAppearance="@style/Text.Uvc.Body" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/switch_battery_keep_alive"
                    android:textAppearance="@style/Text.Uvc.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/switch_battery_keep_alive_hint"
                    android:textAppearance="@style/Text.Uvc.Label" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- HTTP -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Uvc.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_http"
                    android:textAppearance="@style/Text.Uvc.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/http_cleartext_hint"
                    android:textAppearance="@style/Text.Uvc.Label" />

                <include
                    android:id="@+id/streamBlock1"
                    layout="@layout/stream_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <include
                    android:id="@+id/streamBlock2"
                    layout="@layout/stream_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</com.omoai.simpleuvcstreamer.ui.SteadyNestedScrollView>
